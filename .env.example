# ==============================================================================
# CPC Marketplace — Environment Configuration Template
# NOTE: Do NOT commit real secrets, API keys, or database passwords to git.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cpc_marketplace?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cpc_marketplace"

# Authentication & Sessions
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_hex_32

# S3-Compatible Object Storage (Cloudflare R2 / AWS S3)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_NAME=cpc-marketplace-assets
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key

# Payment Gateway (Razorpay India Sandbox)
RAZORPAY_KEY_ID=rzp_test_your_test_key_id
RAZORPAY_KEY_SECRET=your_test_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret

# Task & Session Cryptography
TASK_SESSION_SECRET=generate_another_random_secret_string

# Coin Economy Configuration (Defaults)
DEFAULT_COINS_PER_INR=1
TASK_MAX_DAILY_COMPLETIONS=5
