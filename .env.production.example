# ==============================================================================
# CPC Marketplace — PRODUCTION Environment Configuration
# ==============================================================================

# Application Environment (Enforces Strict HSTS, CSP, and Secure Cookies)
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://cpcmarketplace.com

# PostgreSQL Production Database (PgBouncer / Managed AWS RDS / Supabase)
DATABASE_URL="postgresql://cpc_prod_user:STRONG_PRODUCTION_DB_PASSWORD@prod-db-pooler.internal:6543/cpc_marketplace_prod?schema=public&pgbouncer=true&connection_limit=50"
DIRECT_URL="postgresql://cpc_prod_user:STRONG_PRODUCTION_DB_PASSWORD@prod-db-direct.internal:5432/cpc_marketplace_prod"

# Authentication & Sessions (Generate with: openssl rand -hex 64)
SESSION_SECRET="GENERATE_64_CHAR_HEX_RANDOM_SECRET_FOR_PROD"
NEXTAUTH_URL=https://cpcmarketplace.com
NEXTAUTH_SECRET="GENERATE_64_CHAR_HEX_RANDOM_SECRET_FOR_PROD"

# Private Object Storage (Cloudflare R2 / AWS S3 Private Encrypted Bucket)
S3_ENDPOINT="https://production-account.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET_NAME="cpc-marketplace-production-assets"
S3_ACCESS_KEY_ID="PROD_R2_ACCESS_KEY"
S3_SECRET_ACCESS_KEY="PROD_R2_SECRET_KEY"

# Payment Gateway (Live Razorpay India Production Credentials)
RAZORPAY_KEY_ID="rzp_live_PROD_KEY_ID"
RAZORPAY_KEY_SECRET="PROD_LIVE_SECRET_KEY"
RAZORPAY_WEBHOOK_SECRET="PROD_LIVE_WEBHOOK_SIGNING_SECRET"

# Shortlink & Task Verification Secrets
TASK_SESSION_SECRET="PROD_TASK_CRYPTO_SECRET"
SHORTLINK_POSTBACK_SECRET="PROD_POSTBACK_SIGNING_SECRET"

# Telemetry, Structured Logging & Error Monitoring
LOG_LEVEL=INFO
ENABLE_RATE_LIMITING=true
SENTRY_DSN=""

# Optional Redis Cache / Distributed Rate Limiter
REDIS_URL=""
