# ==============================================================================
# CPC Marketplace — STAGING Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=staging
PORT=3000
NEXT_PUBLIC_APP_URL=https://staging.cpcmarketplace.com

# PostgreSQL Staging Database (Connection Pooling Recommended)
DATABASE_URL="postgresql://cpc_staging_user:SECURE_STAGING_PASSWORD@staging-db.internal:5432/cpc_marketplace_staging?schema=public&connection_limit=20"
DIRECT_URL="postgresql://cpc_staging_user:SECURE_STAGING_PASSWORD@staging-db.internal:5432/cpc_marketplace_staging"

# Authentication & Sessions (Minimum 64-character random secret)
SESSION_SECRET="GENERATE_64_CHAR_HEX_RANDOM_SECRET_FOR_STAGING"
NEXTAUTH_URL=https://staging.cpcmarketplace.com
NEXTAUTH_SECRET="GENERATE_64_CHAR_HEX_RANDOM_SECRET_FOR_STAGING"

# Object Storage (Cloudflare R2 Staging Bucket)
S3_ENDPOINT="https://staging-account.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET_NAME="cpc-marketplace-staging-assets"
S3_ACCESS_KEY_ID="STAGING_R2_ACCESS_KEY"
S3_SECRET_ACCESS_KEY="STAGING_R2_SECRET_KEY"

# Payment Gateway (Razorpay Sandbox/Test Mode)
RAZORPAY_KEY_ID="rzp_test_STAGING_KEY_ID"
RAZORPAY_KEY_SECRET="STAGING_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="STAGING_WEBHOOK_SIGNING_SECRET"

# Shortlink & Task Verification Secrets
TASK_SESSION_SECRET="STAGING_TASK_CRYPTO_SECRET"
SHORTLINK_POSTBACK_SECRET="STAGING_POSTBACK_VERIFICATION_SECRET"

# Telemetry & Logging
LOG_LEVEL=DEBUG
ENABLE_RATE_LIMITING=true
